new file mode 100644
index 0000000..5b8566d
--- /dev/null
+++ b/tests/test_output_budget.py
@@ -0,0 +1,213 @@
+"""Small end-to-end decode loops: the verifier's bonus must fit the output budget."""
+
+from types import SimpleNamespace
+
+import mlx.core as mx
+import pytest
+
+from mlx_dspark import generate as g
+
+
+VOCAB = 64
+PROMPT = [7, 8, 9, 10, 11, 12]
+
+
+def _logits(ids):
+    rows = []
+    for token in ids:
+        row = [-100.0] * VOCAB
+        row[(int(token) + 1) % VOCAB] = 100.0
+        rows.append(row)
+    return mx.array([rows])
+
+
+class _Cache:
+    def __init__(self):
+        self.offset = 0
+        self.k = mx.zeros((1,))
+
+
+class _Target:
+    def make_cache(self):
+        return [_Cache()]
+
+    def reset_spec(self):
+        pass
+
+    def prefill(self, ids, cache, tap=None, **kwargs):
+        cache[0].offset += ids.shape[1]
+        return _logits(ids[0].tolist()), mx.zeros((1, ids.shape[1], 1))
+
+    def plain(self, ids, cache):
+        cache[0].offset += ids.shape[1]
+        return _logits(ids[0].tolist())
+
+    def verify(self, ids, cache, tap):
+        cache[0].offset += ids.shape[1]
+        return _logits(ids[0].tolist()), mx.zeros((1, ids.shape[1], 1))
+
+    def rollback(self, cache, n_rejected, accepted):
+        cache[0].offset -= n_rejected
+
+
+class _Tok:
+    eos_token_id = 999
+
+    def decode(self, ids):
+        return " ".join(map(str, ids))
+
+    def convert_tokens_to_ids(self, token):
+        return None
+
+
+class _DSpark:
+    max_draft = 4
+    confidence_head = None
+
+    def __init__(self, wrong=False):
+        self.config = SimpleNamespace(target_layer_ids=(0,), mask_token_id=0)
+        self.wrong = wrong
+
+    def make_ctx_cache(self):
+        return [_Cache()]
+
+    def update_context(self, fused, ctx_offset, ctx_caches):
+        ctx_caches[0].offset = ctx_offset + fused.shape[1]
+
+    def draft_width(self, cap):
+        return cap
+
+    def embed(self, ids):
+        return ids
+
+    def backbone(self, noise, n_cached, ctx_caches):
+        return noise
+
+    def head_slice(self, hidden, cap):
+        return hidden[:, :cap]
+
+    def compute_logits(self, hidden):
+        return mx.zeros((1, hidden.shape[1], VOCAB))
+
+    def sample_block(self, logits, first_prev_token):
+        return mx.array([(first_prev_token + i + 1 + self.wrong) % VOCAB
+                         for i in range(logits.shape[0])])
+
+
+class _DFlash:
+    embed_tokens = object()
+    candidate_selector = None
+
+    def __init__(self, selector=False, wrong=False):
+        self.config = SimpleNamespace(target_layer_ids=(0,), block_size=5,
+                                      mask_token_id=0, layer_types=(), sliding_window=None)
+        if selector:
+            self.candidate_selector = object()
+        self.wrong = wrong
+
+    def make_cache(self):
+        return [_Cache()]
+
+    def project_ctx(self, fused):
+        return fused
+
+    def append_ctx(self, rows, cache):
+        cache[0].offset += rows.shape[1]
+
+    def __call__(self, block, pending_ctx, dcache, logits_start):
+        anchor = int(block[0, 0].item())
+        return _logits([anchor + i + self.wrong - 1 for i in range(1, 5)])
+
+    def select_block(self, block, pending_ctx, dcache, *, cap, anchor_id, **kwargs):
+        return (mx.array([(anchor_id + i + 1 + self.wrong) % VOCAB
+                          for i in range(cap)]),)
+
+
+@pytest.mark.parametrize("budget", [1, 2, 3, 5, 32])
+@pytest.mark.parametrize("mode", ["dspark", "dflash", "dflash2", "dspark_lookup", "dflash_lookup"])
+@pytest.mark.parametrize("wrong", [False, True])
+def test_speculative_budget_and_cache_match_baseline(monkeypatch, budget, mode, wrong):
+    if mode.endswith("lookup"):
+        from mlx_dspark import lookup
+
+        class _Index:
+            def __init__(self, **kwargs):
+                self.last = None
+
+            def extend(self, ids):
+                self.last = ids[-1]
+
+            def propose(self, **kwargs):
+                return [(self.last + i + 1) % VOCAB for i in range(8)]
+
+        monkeypatch.setattr(lookup, "NGramIndex", _Index)
+
+    target, tok = _Target(), _Tok()
+    baseline = g.greedy_generate(target, tok, prompt_ids=PROMPT,
+                                 max_new_tokens=budget)
+    cache = target.make_cache()
+    rounds = []
+    common = dict(prompt_ids=PROMPT, cache=cache, max_new_tokens=budget,
+                  lookup_drafts=mode.endswith("lookup"), on_round=lambda **r: rounds.append(r))
+    if mode.startswith("dspark"):
+        result = g.speculative_generate(target, tok, _DSpark(wrong),
+                                        ctx_caches=[_Cache()], max_draft_tokens=4, **common)
+    else:
+        result = g.dflash_generate(target, tok, _DFlash(mode == "dflash2", wrong), **common)
+
+    assert result.token_ids == baseline.token_ids
+    assert result.num_tokens == budget
+    assert result.finish_reason == "length"
+    assert sum(result.accept_lengths) == budget - 1
+    assert sum(r["committed"] for r in rounds) == budget - 1
+    assert all(r["committed"] <= r["drafted"] + 1 for r in rounds)
+    if mode.endswith("lookup") and budget >= 3:
+        assert result.lookup_rounds > 0
+    # The last emitted token is pending; the target cache holds all earlier IDs.
+    assert cache[0].offset == len(PROMPT) + budget - 1
+
+
+@pytest.mark.parametrize("mode", ["dspark", "dflash", "dflash2"])
+def test_eos_inside_accepted_block_trims_cache(mode):
+    target, tok = _Target(), _Tok()
+    tok.eos_token_id = 15
+    cache = target.make_cache()
+    common = dict(prompt_ids=PROMPT, cache=cache, max_new_tokens=5, lookup_drafts=False)
+    if mode == "dspark":
+        result = g.speculative_generate(target, tok, _DSpark(),
+                                        ctx_caches=[_Cache()], max_draft_tokens=4, **common)
+    else:
+        result = g.dflash_generate(target, tok, _DFlash(mode == "dflash2"), **common)
+    assert result.token_ids == [13, 14, 15]
+    assert result.finish_reason == "stop"
+    assert result.accept_lengths == [2]
+    assert cache[0].offset == len(PROMPT) + 2
+
+
+def test_dflash_final_plain_step_preserves_prompt_checkpoint_for_next_request():
+    from mlx_dspark.dflash_model import DFlashCtxWindow
+
+    target, tok, drafter = _Target(), _Tok(), _DFlash()
+    cache, window = target.make_cache(), DFlashCtxWindow()
+    saved = {}
+
+    def checkpoint(c, x, pos):
+        saved["cache"] = target.make_cache()
+        saved["cache"][0].offset = c[0].offset
+        saved["window"] = DFlashCtxWindow()
+        saved["window"].set(x[0].k, end=x[0].end)
+
+    first = g.dflash_generate(target, tok, drafter, prompt_ids=PROMPT,
+                              cache=cache, ctx_caches=[window], max_new_tokens=2,
+                              on_prefill=checkpoint)
+    assert first.token_ids == [13, 14]
+    assert cache[0].offset == len(PROMPT) + 1
+    assert window.end == saved["window"].end == len(PROMPT)
+    assert saved["cache"][0].offset == len(PROMPT)
+
+    next_prompt = PROMPT + [13]
+    second = g.dflash_generate(target, tok, drafter, prompt_ids=next_prompt,
+                               cache=saved["cache"], ctx_caches=[saved["window"]],
+                               reuse_len=len(PROMPT), max_new_tokens=2)
+    assert second.token_ids == [14, 15]
+    assert saved["cache"][0].offset == len(next_prompt) + 1
